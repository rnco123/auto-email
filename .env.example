# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=patients@yourclinic.com

# OpenAI
OPENAI_API_KEY=
# Best model for human replies + thread context (gpt-4.1 or gpt-4o)
OPENAI_MODEL=gpt-4.1
# Optional overrides
OPENAI_CLASSIFY_MODEL=
OPENAI_REPLY_MODEL=

# Supabase (Settings → API → Project URL + Publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dashboard (simple password gate)
DASHBOARD_PASSWORD=change-me

# App URL (for links in docs; Vercel sets this in prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sample/demo: skip identity verification (set to false for production)
DISABLE_PATIENT_VERIFICATION=true

# Optional: timezone for appointment formatting
APP_TIMEZONE=America/New_York

# Optional: insert sample thread/messages on dashboard load (dev check)
SEED_SAMPLE_LOGS=false

# Optional: queue inbound processing (use with Vercel Cron)
EMAIL_USE_QUEUE=false
CRON_SECRET=
