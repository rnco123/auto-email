# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=patients@yourclinic.com

# OpenAI
OPENAI_API_KEY=
# Best model for human replies + thread context (gpt-4.1 or gpt-4o)
OPENAI_MODEL=gpt-4.1
# Optional overrides
OPENAI_CLASSIFY_MODEL=
OPENAI_REPLY_MODEL=

# Supabase — use service role on the server for reliable reads (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard (simple password gate)
DASHBOARD_PASSWORD=change-me

# App URL (for links in docs; Vercel sets this in prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sample/demo: skip identity verification (set to false for production)
DISABLE_PATIENT_VERIFICATION=true

# Optional: timezone for appointment formatting
APP_TIMEZONE=America/New_York

# Dev: in-memory chat turn (same pipeline as email; no Resend). Do not enable in prod.
ENABLE_DEV_CHAT=false

# Optional: queue inbound processing (use with Vercel Cron)
EMAIL_USE_QUEUE=false
CRON_SECRET=
